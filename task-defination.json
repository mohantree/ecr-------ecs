{
  "family": "ecr-ecs-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::595083028893:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "ecr-ecs-container",
      "image": "595083028893.dkr.ecr.ap-south-1.amazonaws.com/ecr---ecs:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ]
}